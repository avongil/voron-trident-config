    -50, 18
    125, 298
    300, 18
points:
    30, 5
    125, 195
    220, 5

##--------------------------------------------------------------------

speed: 200
horizontal_move_z: 10
retries: 3
retry_tolerance: 0.02



#####################################################################
#   Macros
#####################################################################

[skew_correction]


[gcode_macro _PRINT_VARS]
# Stores print session variables that need to survive TURN_OFF_HEATERS
variable_chamber_target: 55
gcode:
    # intentionally empty

[gcode_macro PRINT_START]
gcode:


    {% set BED_TEMP = params.BED_TEMP|default(60)|float %}
    {% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(210)|float %}
    {% set CHAMBER_TEMP_MIN = params.CHAMBER_TEMP_MIN|default(32)|float %}
    {% set CHAMBER_TEMP_MAX = params.CHAMBER_TEMP|default(55)|float %}
     {% set PROBINGTOUCHTEMP = 120 %}
     {% set PROBINGTOUCHTEMPPLUS = PROBINGTOUCHTEMP+5 %}
     {% set PROBINGTOUCHTEMPMINUS = PROBINGTOUCHTEMP-5 %}
     {% set saved_clean_nozzle = printer.save_variables.variables.clean_nozzle|default(0)|int %}
     {% set do_clean_nozzle = params.CLEAN_NOZZLE|default(saved_clean_nozzle)|int %}   # driven by TOGGLE_NOZZLE_CLEAN button; slicer param overrides if passed

    SET_GCODE_OFFSET Z=0                                 # Set offset to 0
    STATUS_HOMING ; Cyan logo and white nozzle
    G28
    G90

    BED_MESH_CLEAR                                       # Clear old saved bed mesh (if any)

    SKEW_PROFILE LOAD=Skew1                              # XY skew correction (cleared in PRINT_END / CANCEL_PRINT)


    ### controlled cooling of the chamber

    SET_DISPLAY_TEXT MSG="CHAMBER TARGET TEMP: {CHAMBER_TEMP_MAX}C"
    SET_TEMPERATURE_FAN_TARGET temperature_fan="chamberfan" target={CHAMBER_TEMP_MAX}
    SET_GCODE_VARIABLE MACRO=_PRINT_VARS VARIABLE=chamber_target VALUE={CHAMBER_TEMP_MAX}  ; save for use in PRINT_END
    ###

    ### DragonBreath chamber heater: only when the slicer passes CHAMBER_TEMP (no 55C default)
    {% set DB_TARGET = [params.CHAMBER_TEMP|default(0)|float, 70]|min %}
    {% if DB_TARGET > 0 %}
    SET_DISPLAY_TEXT MSG="Chamber heater: {DB_TARGET}C"
    M141 S{DB_TARGET}               # non-blocking; heats during bed heat-up and soak
    {% endif %}

         ### Controlled Heating
    SET_FAN_SPEED FAN=Nevermore SPEED=.5

    G0 X125 Y125 Z30 F3600          # Move to safe center position

    # Pre-heat hotend to probing temperature (non-blocking + tolerance)
    SET_DISPLAY_TEXT MSG="Heating Hot End: {PROBINGTOUCHTEMP}C"
    M104 S{PROBINGTOUCHTEMP}                       # Set target extruder temp but do NOT wait

    # Start bed heating (unchanged)
    SET_DISPLAY_TEXT MSG="Heating Bed: {BED_TEMP}C"
    M190 S{BED_TEMP}                # Wait for bed (still blocking; adjust PID if needed)

    TEMPERATURE_WAIT SENSOR=extruder MINIMUM={PROBINGTOUCHTEMPMINUS}   # Proceed once within +- ~5 °C tolerance - just in case bed was hot.
    TEMPERATURE_WAIT SENSOR=extruder MAXIMUM={PROBINGTOUCHTEMPPLUS}

    ## Set and wait for chamber to reach temperature
    SET_DISPLAY_TEXT MSG="Heatsoak: {CHAMBER_TEMP_MIN}C"
    TEMPERATURE_WAIT SENSOR="temperature_sensor chamber" MINIMUM={CHAMBER_TEMP_MIN}
    ### end Controlled Heating

    SET_DISPLAY_TEXT MSG="Z Tilt Leveling"
    STATUS_LEVELING ; Pink logo and white nozzle
    Z_TILT_ADJUST # z_tilt with a dirty nozzle
    G28 Z                                                # Home Z again after Z_TILT_ADJUST

    G90                            ; absolute positioning

    SET_DISPLAY_TEXT MSG="Bed mesh"                      # Display info on display
    STATUS_MESHING                                       # Set LEDs to bed mesh-mode
    BED_MESH_CALIBRATE                                   # Start the bed mesh (add ADAPTIVE=1) for adaptive bed mesh


     # Nozzle Cleaning
    {% if do_clean_nozzle %}
    SET_DISPLAY_TEXT MSG="Heating Hot End: 240C"
    M104 S245                       # Set target but do NOT wait
    G0X240.Y245.
    TEMPERATURE_WAIT SENSOR=extruder MINIMUM=240   # Proceed once within ~5 °C tolerance.

    M117 Cleaning nozzle
    STATUS_CLEANING
    CLEAN_NOZZLE
    {% else %}
    M117 Skipping nozzle clean
    {% endif %}
    # End Nozzle Cleaning


    M104 S{PROBINGTOUCHTEMP}                       # Set target but do NOT wait
    SET_DISPLAY_TEXT MSG="Heating Hot End: {PROBINGTOUCHTEMP}"
    TEMPERATURE_WAIT SENSOR=extruder MAXIMUM={PROBINGTOUCHTEMPPLUS}   # Proceed once within ~5 °C tolerance - just in case bed was hot.
    M106 S0

    SET_DISPLAY_TEXT MSG="Cartographer Touch Z"
    CARTOGRAPHER_TOUCH_HOME # Calibrate z offset only with hot nozzle



    M140 S{BED_TEMP} # heat bed, do not wait.
        SET_DISPLAY_TEXT MSG="Heating Hot End: {EXTRUDER_TEMP}C"
    M109 S{ EXTRUDER_TEMP }  ; Wait for nozzle to get to target temperature.
        SET_DISPLAY_TEXT MSG="Heating Bed: {BED_TEMP}C"
    M190 S{BED_TEMP}


   # G28 Z

    STATUS_PRINTING
    SET_FAN_SPEED FAN=Nevermore SPEED=.25
    M117 Purging
    PURGE_LINE
    M117 PRINTING


#--------------------------------------------------------------------

[save_variables]
# Adjust this path if your install uses a different config directory
# (e.g. /home/pi/klipper_config/variables.cfg on older installs).
filename: ~/printer_data/config/variables.cfg

[gcode_macro TOGGLE_NOZZLE_CLEAN]
description: Toggle whether PRINT_START runs the nozzle scrub - persists across restarts, shows as a button in Fluidd's Macros panel
gcode:
    {% set current = printer.save_variables.variables.clean_nozzle|default(0)|int %}
    {% set new_val = 0 if current else 1 %}
    SAVE_VARIABLE VARIABLE=clean_nozzle VALUE={new_val}
    {% if new_val %}
        RESPOND MSG="Nozzle clean: ON (will scrub at next PRINT_START)"
        M117 Nozzle clean: ON
    {% else %}
        RESPOND MSG="Nozzle clean: OFF (will skip scrub at next PRINT_START)"
        M117 Nozzle clean: OFF
    {% endif %}

[gcode_macro PRINT_END]
#   Use PRINT_END for the slicer ending script - please customise for your slicer of choice
gcode:
 
    SET_FAN_SPEED FAN=Nevermore SPEED=1.0
    SET_DISPLAY_TEXT MSG="CHAMBER AIR FILTERING"

    # safe anti-stringing move coords
    {% set th = printer.toolhead %}
    {% set x_safe = th.position.x + 20 * (1 if th.axis_maximum.x - th.position.x > 20 else -1) %}
    {% set y_safe = th.position.y + 20 * (1 if th.axis_maximum.y - th.position.y > 20 else -1) %}
    {% set z_safe = [th.position.z + 12, th.axis_maximum.z]|min %}
    {% set cooldown_target = printer["gcode_macro _PRINT_VARS"].chamber_target - 5|default(50)|float %}  ; read saved target - immune to TURN_OFF_HEATERS

    SET_SKEW CLEAR=1
    SAVE_GCODE_STATE NAME=STATE_PRINT_END

    M400                           ; wait for buffer to clear
    G92 E0                         ; zero the extruder
    G1 E-2.0 F3600                 ; retract filament

    TURN_OFF_HEATERS
    M141 S0                        ; DragonBreath chamber heater off (TURN_OFF_HEATERS also covers it)

    G90                                      ; absolute positioning
    G0 X{x_safe} Y{y_safe} Z{z_safe} F20000  ; move nozzle to remove stringing
    G0 X{th.axis_maximum.x//2} Y{th.axis_maximum.y - 2} F3600  ; park nozzle at rear
    M107                                     ; turn off fan

    BED_MESH_CLEAR
    RESTORE_GCODE_STATE NAME=STATE_PRINT_END

    G4 P60000                      ; Dwell 1 min so Nevermore can filter chamber air then turn on the exhaust fan

    # === Cooldown logic ===
    # Capture chamberfan target set in PRINT_START minus 5 °C.
    SET_DISPLAY_TEXT MSG="COOLDOWN CHAMBER TARGET TEMP: {cooldown_target}C"
    SET_TEMPERATURE_FAN_TARGET temperature_fan="chamberfan" target={cooldown_target}

    SET_FAN_SPEED FAN=Nevermore SPEED=0
    #SET_FAN_SPEED FAN=exhaust_fan SPEED=0 #not used anymore
    SET_GCODE_VARIABLE MACRO=_MANUAL_TOOL VARIABLE=current VALUE=-1   ; forget loaded filament slot

#####################################################################
#   Cancel Print - raise Z 50mm, or home Z if that would over-travel
#####################################################################
# NOTE: this section MERGES with fluidd.cfg's [gcode_macro CANCEL_PRINT] and
# its gcode REPLACES Fluidd's entirely. CANCEL_PRINT_BASE is Klipper's built-in
# cancel, which does NOT turn off heaters/fans - so that's done here.
# Also used by virtual_sdcard on_error_gcode.

[gcode_macro CANCEL_PRINT]
description: Cancel the actual running print
rename_existing: CANCEL_PRINT_BASE
gcode:
    _CLIENT_RETRACT LENGTH=5         ; retract (Fluidd helper, skips if nozzle is cold)
    TURN_OFF_HEATERS                 ; also turns bed fans off (bedfans.cfg override)
    M141 S0                          ; DragonBreath chamber heater off
    M106 S0                          ; part cooling fan off
    SET_SKEW CLEAR=1
    SET_IDLE_TIMEOUT TIMEOUT={printer.configfile.settings.idle_timeout.timeout}  ; undo 12h timeout if cancelled while paused
    UPDATE_DELAYED_GCODE ID=_M600_HEATER_TIMEOUT DURATION=0
    SET_GCODE_VARIABLE MACRO=_MANUAL_TOOL VARIABLE=current VALUE=-1
    RESPOND TYPE=command MSG="action:prompt_end"
    CANCEL_PRINT_BASE
    {% set current_z = printer.toolhead.position.z|float %}
    {% set max_z = printer.toolhead.axis_maximum.z|float %}
    {% if current_z + 50 <= max_z %}
        G91                          ; relative positioning
        G1 Z50 F900                  ; raise Z 50mm (900mm/min = configured max_z_velocity)
        G90                          ; absolute positioning
    {% else %}
        G28 Z                       ; not enough headroom, home Z instead
    {% endif %}

#####################################################################
#   Go to Maintenance position Macro
#####################################################################

[gcode_macro MAINT_POS]
  gcode:
        G0X125.Y0.Z240.

#####################################################################
#   Pause and Resume Macros for fillament sensor
#####################################################################


[pause_resume]
recover_velocity: 50.
#   When capture/restore is enabled, the speed at which to return to
#   the captured position (in mm/s). Default is 50.0 mm/s.

[gcode_macro M600]
description: Manual filament/color change. Slicer: change filament G-code = M600 T[next_extruder]
gcode:
    {% set tool = params.T|default(-1)|int %}
    {% set cur = printer["gcode_macro _MANUAL_TOOL"].current|int %}
    {% if tool >= 0 and tool == cur %}
        RESPOND MSG="M600: T{tool} is already loaded - no change needed"
    {% elif printer.pause_resume.is_paused %}
        RESPOND MSG="M600: already paused"
    {% elif printer.print_stats.state != "printing" %}
        RESPOND TYPE=error MSG="M600 only works during a print. Use UNLOAD_FILAMENT / LOAD_FILAMENT instead."
    {% else %}
        {% if tool >= 0 %}
        SET_GCODE_VARIABLE MACRO=_MANUAL_TOOL VARIABLE=current VALUE={tool}
        {% endif %}
        PAUSE X=185 Y=257 Z_MIN=10 HEATER_OFF=0   ; park over the rear purge bucket, keep hotend hot
        UNLOAD_FILAMENT
        UPDATE_DELAYED_GCODE ID=_M600_HEATER_TIMEOUT DURATION=900   ; hotend off after 15 min if nobody comes
        _M600_PROMPT T={tool}
    {% endif %}

[gcode_macro _M600_PROMPT]
gcode:
    {% set tool = params.T|default(-1)|int %}
    {% set what = "filament %d (T%d)" % (tool + 1, tool) if tool >= 0 else "the next filament" %}
    RESPOND MSG="Filament change: load {what}, then press RESUME"
    RESPOND TYPE=command MSG="action:prompt_begin Filament change"
    RESPOND TYPE=command MSG="action:prompt_text Old filament is unloaded. Insert {what}, press Load, purge until the color is clean, then Resume."
    RESPOND TYPE=command MSG="action:prompt_button_group_start"
    RESPOND TYPE=command MSG="action:prompt_button Unload|UNLOAD_FILAMENT|secondary"
    RESPOND TYPE=command MSG="action:prompt_button Load|LOAD_FILAMENT|primary"
    RESPOND TYPE=command MSG="action:prompt_button Purge 25mm|_PURGE_MORE|info"
    RESPOND TYPE=command MSG="action:prompt_button_group_end"
    RESPOND TYPE=command MSG="action:prompt_footer_button Resume|RESUME|success"
    RESPOND TYPE=command MSG="action:prompt_show"

[delayed_gcode _M600_HEATER_TIMEOUT]
gcode:
    {% if printer.pause_resume.is_paused %}
        M104 S0
        RESPOND MSG="Filament change: hotend turned off after 15 min. Load / Resume will reheat it."
    {% endif %}

[gcode_macro _ENSURE_HOT]
description: Helper: during a pause, reheat to the print temperature; otherwise require a hot nozzle
gcode:
    {% set etemp = printer["gcode_macro RESUME"].etemp|float %}
    {% set min_t = printer.configfile.settings.extruder.min_extrude_temp|float %}
    {% if printer.pause_resume.is_paused and etemp > 0 %}
        {% if printer.extruder.target < etemp or printer.extruder.temperature < etemp - 5 %}
            RESPOND MSG="Heating hotend to {etemp|int}C"
            M109 S{etemp}
        {% endif %}
        UPDATE_DELAYED_GCODE ID=_M600_HEATER_TIMEOUT DURATION=900   ; restart the 15 min timer
    {% elif printer.extruder.temperature < min_t %}
        { action_raise_error("Hotend is below %dC - heat it first" % min_t) }
    {% endif %}

[gcode_macro _PURGE_MORE]
gcode:
    _ENSURE_HOT
    SAVE_GCODE_STATE NAME=purge_more
    M83
    G1 E25 F300
    RESTORE_GCODE_STATE NAME=purge_more

[gcode_macro _MANUAL_TOOL]
description: Helper: remembers which filament slot (T0-T3) is loaded
variable_current: -1
gcode:
    {% set t = params.T|int %}
    SET_GCODE_VARIABLE MACRO=_MANUAL_TOOL VARIABLE=current VALUE={t}
    RESPOND MSG="Active filament: T{t}"

[gcode_macro PAUSE]
rename_existing: BASE_PAUSE
gcode:
    # Parameters: Z=hop (10)  X/Y=park position (front centre)  Z_MIN=lowest park height  HEATER_OFF=1 turns hotend off
    {% set z = params.Z|default(10)|float %}
    {% set z_min = params.Z_MIN|default(0)|float %}
    {% set park_x = params.X|default(printer.toolhead.axis_maximum.x/2)|float %}
    {% set park_y = params.Y|default(printer.toolhead.axis_minimum.y+5)|float %}
    {% set heater_off = params.HEATER_OFF|default(1)|int %}
    {% set pos = printer.gcode_move.gcode_position %}
    {% set z_park = [[pos.z + z, z_min]|max, printer.toolhead.axis_maximum.z - 1]|min %}

    {% if printer['pause_resume'].is_paused|int == 0 %}
        SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=zhop VALUE={z_park - pos.z}                 ; set z hop variable for reference in resume macro
        SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=etemp VALUE={printer['extruder'].target}    ; set hotend temp variable for reference in resume macro
        SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=pos_x VALUE={pos.x}                         ; where to go back to (XY first, then Z)
        SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=pos_y VALUE={pos.y}
        SAVE_GCODE_STATE NAME=PAUSE                                                          ; save current print position for resume
        BASE_PAUSE                                                                           ; pause print
        G90                                                                                  ; absolute positioning
        G1 Z{z_park} F900                                                                    ; lift first
        G1 X{park_x} Y{park_y} F6000                                                         ; then park
        SAVE_GCODE_STATE NAME=PAUSEPARK                                                      ; save parked position in case toolhead is moved during the pause
        {% if heater_off %}
        M104 S0                                                                              ; turn off hotend
        {% endif %}
        SET_IDLE_TIMEOUT TIMEOUT=43200                                                       ; set timeout to 12 hours
    {% endif %}

[gcode_macro RESUME]
rename_existing: BASE_RESUME
variable_zhop: 0
variable_etemp: 0
variable_pos_x: 0
variable_pos_y: 0
gcode:
    # Parameters
    {% set e = params.E|default(2.5)|float %}

    {% if printer['pause_resume'].is_paused|int == 1 %}
        RESPOND TYPE=command MSG="action:prompt_end"                                 ; close the filament-change dialog
        UPDATE_DELAYED_GCODE ID=_M600_HEATER_TIMEOUT DURATION=0                      ; cancel the hotend-off timer
        SET_IDLE_TIMEOUT TIMEOUT={printer.configfile.settings.idle_timeout.timeout}  ; set timeout back to configured value
        {% if etemp > 0 %}
            M109 S{etemp|int}                                                        ; wait for hotend to heat back up
        {% endif %}
        RESTORE_GCODE_STATE NAME=PAUSEPARK MOVE=1 MOVE_SPEED=100                     ; back to the parked position in case toolhead was moved during pause
        M83                                                                          ; relative extruder positioning
        {% if printer[printer.toolhead.extruder].temperature >= printer.configfile.settings.extruder.min_extrude_temp %}
            G1 E{e} F300                                                             ; prime nozzle at the park position
        {% endif %}
        G90
        G1 X{pos_x} Y{pos_y} F6000                                                   ; travel back at park height (never lowers Z near the bucket)
        RESTORE_GCODE_STATE NAME=PAUSE MOVE=1 MOVE_SPEED=60                          ; lower Z and restore print state
        BASE_RESUME                                                                  ; resume print
    {% endif %}




######################################################################
# Slicer compatibility
######################################################################
[gcode_macro M900]
description: Set pressure advance (Marlin-style M900 K<value>)
gcode:
    {% if params.K is defined %}
        SET_PRESSURE_ADVANCE ADVANCE={params.K|float}
    {% endif %}

# Manual multicolor: T0-T3 only record which filament is loaded. The pause itself
# comes from the slicer's "Change filament G-code" (M600 T[next_extruder]), so a
# tool change never pauses twice.
[gcode_macro T0]
gcode:
    _MANUAL_TOOL T=0

[gcode_macro T1]
gcode:
    _MANUAL_TOOL T=1

[gcode_macro T2]
gcode:
    _MANUAL_TOOL T=2

[gcode_macro T3]
gcode:
    _MANUAL_TOOL T=3


[gcode_macro LOAD_FILAMENT]
gcode:
    {% set speed = params.SPEED|default(300) %}      # mm/min (5 mm/s) purge
    {% set fast = params.FAST|default(1800) %}       # mm/min (30 mm/s) - F is mm/min, not mm/s
    _ENSURE_HOT
    SAVE_GCODE_STATE NAME=load_state
    ##M300 # beep
    G91
    M83
    G92 E0
    G1 E60 F{fast} # fast-load
    G1 E50 F{speed} # purge
    ##M300
    ##M300
    RESTORE_GCODE_STATE NAME=load_state



[gcode_macro UNLOAD_FILAMENT]
gcode:
    {% set speed = params.SPEED|default(300) %}      # mm/min (5 mm/s) purge
    {% set fast = params.FAST|default(1800) %}       # mm/min (30 mm/s)
    _ENSURE_HOT
    SAVE_GCODE_STATE NAME=unload_state
    G91
    M83
    ##M300 # beep
    G92 E0
    G1 E5 F{speed} # purge
    G1 E-100 F{fast} # fast-unload
    ##M300
    ##M300
    RESTORE_GCODE_STATE NAME=unload_state

