#####################################################################
#   LED Control
#####################################################################

[output_pin caselight]
# Chamber Lighting - FAN0 connector (PA8), a real 2-pin JST-XH fan header.
# Simple always-on 24V LED board (FlashForge AD5X replacement chamber
# light, non-addressable, single 24V input). FAN0 is free on this Trident
# because the part-cooling and hotend fans both live on the EBBCan
# toolboard now (can0:FAN0 / can0:FAN1 in toolhead_btt_ebbcan_G0B1_v1.2.cfg)
# -- confirmed against printer_cfg_copper_backups/printer_copper.cfg,
# which had this mainboard FAN0 wired to the print cooling fan before that
# move (pin: PA8).
#
# IMPORTANT: unlike the heater outputs, Octopus fan headers get their
# supply voltage from an onboard jumper block (labelled near the fan
# headers, selects VIN/24V vs 12V vs 5V) -- double check that jumper is
# set to VIN/24V before plugging in a 24V light, or it'll get starved.
# Most Voron builds already run fans at 24V so it's likely already correct.
#
# (HE2/PB10 also works electrically for this and was the original plan,
# but it's not a JST-XH connector on this board -- left here as a fallback
# if you ever want the fan header for something else instead:
#   pin: PB10
# )
pin: PA8
pwm:true
shutdown_value: 0
value:1
cycle_time: 0.01

